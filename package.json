{
  "name": "ez-vault",
  "version": "0.0.1",
  "description": "NIP-46 iframe signer",
  "keywords": [
    "nostr",
    "signer",
    "nip-46",
    "nip46"
  ],
  "license": "MIT",
  "author": "arthurfranca",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --import ./tests/setup.js --test 'tests/**/*.test.js'",
    "build": "node bin/build.js",
    "build:watch": "node bin/build.js --watch",
    "start": "node bin/dev.js",
    "// start:peer": "Or open http://localhost:4000 and http://127.0.0.1:4000 for different origins",
    "// start:peer2": "Assumes `npm start` (watcher) is running — it serves the same .dev/ output on a second port.",
    "start:peer": "PORT=4001 EZ_VAULT_SERVE_DIR=.dev python3 server.py",
    "end": "pkill -f 'python3 server.py'"
  },
  "devDependencies": {
    "@dicebear/avataaars": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.5.0",
    "jsqr": "1.4.0",
    "libp2r2p": "0.10.3",
    "neostandard": "^0.13.0",
    "qrcode-generator": "1.4.4",
    "thenameisf": "1.2.0"
  }
}
